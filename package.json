{
  "name": "briefing-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/build-site.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "predev": "node scripts/build-content.mjs",
    "validate": "node scripts/build-content.mjs",
    "import": "node scripts/import-briefings.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "node scripts/build-content.mjs && tsc --noEmit",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:online": "node scripts/verify-pages-online.mjs",
    "archive:sync": "node scripts/archive-sync.mjs",
    "archive:fetch": "node scripts/fetch-source.mjs",
    "archive:publication": "node scripts/archive-publication.mjs",
    "archive:prepare": "node scripts/archive-input.mjs",
    "archive:resources": "node scripts/import-browser-resources.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "^0.18.7",
    "lucide-react": "1.31.0",
    "marked": "^18.0.12",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2"
  },
  "type": "module",
  "overrides": {
    "pixi-live2d-display": {
      "gh-pages": "^6.3.0"
    }
  }
}
